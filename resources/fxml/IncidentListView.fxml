<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ru.scp.foundation.ui.controllers.IncidentListController">
    <top>
        <HBox styleClass="toolbar-bar">
            <Label text="▸" styleClass="toolbar-prefix"/>
            <Label text="%title.incidents" styleClass="toolbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="%filter.from"/> <DatePicker fx:id="fromDate"/>
            <Label text="%filter.to"/>   <DatePicker fx:id="toDate"/>
            <Button text="%btn.apply"   onAction="#onApplyFilter"/>
            <Button text="%btn.reset"   onAction="#onResetFilter"/>
            <Button fx:id="addBtn"  text="%btn.add"    onAction="#onAdd"/>
            <Button fx:id="editBtn" text="%btn.edit"   onAction="#onEdit"/>
            <Button fx:id="delBtn"  text="%btn.delete" onAction="#onDelete" styleClass="danger"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="colDate"     text="%col.occurred"   prefWidth="160"/>
                <TableColumn fx:id="colScp"      text="%col.scp"        prefWidth="120"/>
                <TableColumn fx:id="colSite"     text="%col.site"       prefWidth="120"/>
                <TableColumn fx:id="colMtf"      text="%col.mtf"        prefWidth="140"/>
                <TableColumn fx:id="colSeverity" text="%col.severity"   prefWidth="80"/>
                <TableColumn fx:id="colDesc"     text="%col.description" prefWidth="400"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
