<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="ru.scp.foundation.ui.controllers.LoginController"
           prefWidth="900" prefHeight="600" styleClass="root">

    <!-- Слой 1: анимированный фон -->
    <Canvas fx:id="bgCanvas" width="900" height="600"/>

    <!-- Слой 2: rolling-feed boot-текст в левом верхнем углу -->
    <VBox fx:id="bootFeedBox"
          alignment="TOP_LEFT"
          StackPane.alignment="TOP_LEFT"
          maxWidth="500" maxHeight="80"
          spacing="3">
        <padding><Insets top="16" left="18"/></padding>
    </VBox>

    <!-- Слой 3: правый-нижний инфо-лейбл -->
    <Label text="LINK 0x7A . AES-256-GCM . O5-CMD/2026"
           styleClass="warning-strip"
           StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin><Insets right="18" bottom="14"/></StackPane.margin>
    </Label>

    <!-- Слой 4: центральная карточка логина -->
    <VBox alignment="CENTER" spacing="10" maxWidth="500" maxHeight="540" styleClass="login-card">
        <padding><Insets top="22" right="36" bottom="24" left="36"/></padding>

        <!-- Верхняя мета-строка: DOC // SCP-OS v4.7.2  |  ENCRYPTED -->
        <HBox alignment="CENTER" spacing="0">
            <Label text="DOC // SCP-OS v4.7.2" styleClass="doc-meta" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label text="// ENCRYPTED" styleClass="doc-encrypted"/>
        </HBox>

        <!-- Логотип -->
        <Canvas fx:id="logoCanvas" width="108" height="108"/>

        <Label text="SECURE TERMINAL" styleClass="header"/>
        <Label text="ACCESS REQUIRED" styleClass="subheader"/>

        <Region prefHeight="6"/>

        <!-- Поле LOGIN -->
        <VBox spacing="6">
            <Label text="LOGIN" styleClass="field-label"/>
            <TextField fx:id="loginField" promptText="a.clef"/>
        </VBox>

        <!-- Поле PASSWORD -->
        <VBox spacing="6">
            <Label text="PASSWORD" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="**********"/>
        </VBox>

        <!-- Сообщение об ошибке -->
        <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>

        <Region prefHeight="6"/>

        <!-- Кнопка AUTHENTICATE -->
        <Button fx:id="loginButton" text="AUTHENTICATE" onAction="#onLogin"
                styleClass="primary,lg" prefWidth="260">
            <VBox.margin><Insets left="50" right="50"/></VBox.margin>
        </Button>

        <!-- Нижняя подпись -->
        <Region prefHeight="6"/>
        <Region styleClass="login-card-divider"/>
        <HBox alignment="CENTER" spacing="0">
            <padding><Insets top="6"/></padding>
            <Label text="UNAUTHORIZED ACCESS PROHIBITED"
                   styleClass="warning-strip" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label text="O5-CMD" styleClass="o5-stamp"/>
        </HBox>

    </VBox>

</StackPane>
